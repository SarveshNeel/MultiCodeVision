{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug OpenCV App",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/build/app",
        "args": ["${input:imagePath}"],
        "cwd": "${workspaceFolder}",
        "stopOnEntry": false
      }
    ],
    "inputs": [
        {
            "id": "imagePath",
            "type": "promptString",
            "description": "Enter Image Path:"
        }
    ]
  }